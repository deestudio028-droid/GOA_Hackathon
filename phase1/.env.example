# ==============================================================================
# Phase 1: Reverse Image Search Configuration
# Copy this file to .env and insert your API keys.
# NEVER commit real API keys to version control.
# ==============================================================================

# PRIMARY ENGINE: SerpApi (Google Lens & Google Reverse Search)
# Get your free API key at: https://serpapi.com/ (100 free searches/month)
SERPAPI_API_KEY=your_serpapi_api_key_here

# BACKUP ENGINE 1: Google Cloud Vision API (Web Detection)
# Get your API key from Google Cloud Console -> APIs & Services -> Credentials
# Free tier: 1,000 requests/month forever
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# BACKUP ENGINE 2: Microsoft Bing Visual Search API (Azure)
# Get your key from Azure Portal -> Bing Search Services
# Free tier: 1,000 transactions/month (F0)
BING_SEARCH_API_KEY=your_bing_search_api_key_here

# DEFAULT ENGINE CONFIGURATION:
# Options: "google_lens" (SerpApi - Recommended), "google_vision", "bing_visual"
DEFAULT_SEARCH_ENGINE=google_lens

# Maximum number of results to display
MAX_RESULTS=5
