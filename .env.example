# ==============================================================================
# FaceScan2Chain Environment Configuration Template
# Copy this file to .env and insert your API keys & blockchain credentials.
# NEVER commit real private keys or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Phase 1 & Phase 3: Reverse Image & Social Search Engine
# ------------------------------------------------------------------------------
# Primary Search Engine: SerpApi (Google Lens & Google Reverse Search)
# Get your free API key at: https://serpapi.com/ (100 free searches/month)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Backup Engine 1: Google Cloud Vision API (Web Detection)
# Free tier: 1,000 requests/month forever
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Backup Engine 2: Microsoft Bing Visual Search API (Azure)
# Free tier: 1,000 transactions/month (F0)
BING_SEARCH_API_KEY=your_bing_search_api_key_here

# Default engine configuration: "google_lens", "google_vision", "bing_visual"
DEFAULT_SEARCH_ENGINE=google_lens
MAX_RESULTS=5

# ------------------------------------------------------------------------------
# Phase 4 & Phase 5: Blockchain Anchoring & Verification (Polygon Amoy Testnet)
# ------------------------------------------------------------------------------
# Public RPC Endpoint for Polygon Amoy (Chain ID: 80002)
BLOCKCHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
BLOCKCHAIN_CHAIN_ID=80002

# EVM Private Key for submitting testnet transactions (Burner / Testnet wallet only)
# Fund with free testnet POL at: https://faucet.polygon.technology/
BLOCKCHAIN_PRIVATE_KEY=your_testnet_private_key_here

# Deployed DataAnchor Solidity Smart Contract Address on Polygon Amoy
BLOCKCHAIN_CONTRACT_ADDRESS=0xeb4FA1693171e3d2E7DF42D861453cf6B47CB71D
