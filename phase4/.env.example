# ==============================================================================
# Phase 4: Blockchain Anchoring Configuration
# Network: Polygon Amoy Testnet (Chain ID: 80002)
# ==============================================================================

# Blockchain RPC endpoint (Polygon Amoy testnet public endpoint)
BLOCKCHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Testnet Wallet Private Key (64-character hex string without leading 0x or with 0x)
# NEVER commit or share real private keys. Use a testnet-only burner wallet with test MATIC/POL.
BLOCKCHAIN_PRIVATE_KEY=your_testnet_private_key_here

# Chain ID for network validation (80002 for Polygon Amoy)
BLOCKCHAIN_CHAIN_ID=80002

# Optional Deployed DataAnchor Contract Address (0x...)
# If not set, direct on-chain calldata anchoring is used, or deploy with --deploy-contract
BLOCKCHAIN_CONTRACT_ADDRESS=
